# 이 파일을 같은 폴더에 .env 로 복사해서 채운다. (.env 는 GitHub에 올라가지 않는다)

# 공실뉴스 주소
DEVROOM_BASE_URL=https://www.gongsilnews.com

# Vercel 환경변수 DEVROOM_AGENT_TOKEN 과 똑같은 값 (32자 이상)
DEVROOM_AGENT_TOKEN=

# 선택 — 비워 두면 기본값
# DEVROOM_WORKTREE=C:\Users\user\Desktop\gongsilnews-devroom
# DEVROOM_POLL_SECONDS=30
# CLAUDE_MODEL=opus
