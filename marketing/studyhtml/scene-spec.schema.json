{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.gongsilnews/lecture-motion-director/scene-spec.schema.json",
  "title": "AI Lecture Motion Director Project",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "project", "scenes"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "catalogVersion": { "type": "string" },
    "project": {
      "type": "object",
      "required": ["projectId", "title", "locale", "aspectRatio"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "default": "ko-KR" },
        "aspectRatio": { "type": "string", "const": "16:9" },
        "designPreset": { "type": "string" }
      },
      "additionalProperties": true
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segmentId", "sourceText", "startTime", "endTime", "recommendedMedia"],
        "properties": {
          "segmentId": { "type": "string", "minLength": 1 },
          "sourceText": { "type": "string", "minLength": 1 },
          "startTime": { "type": ["string", "null"] },
          "endTime": { "type": ["string", "null"] },
          "recommendedMedia": {
            "enum": ["INSTRUCTOR", "AVATAR", "SCREEN_RECORDING", "IMAGE", "VIDEO", "MOTION", "NONE"]
          },
          "selectionReason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "scene": {
      "type": "object",
      "required": [
        "sceneId",
        "segmentId",
        "sourceText",
        "startTime",
        "endTime",
        "duration",
        "visualIntent",
        "visualGrammar",
        "renderMode",
        "composition",
        "content",
        "motionSequence",
        "interaction",
        "sound"
      ],
      "properties": {
        "sceneId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "segmentId": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "sourceText": { "type": "string", "minLength": 1 },
        "startTime": { "type": ["string", "null"] },
        "endTime": { "type": ["string", "null"] },
        "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
        "visualIntent": { "type": "string", "minLength": 1 },
        "visualGrammar": {
          "enum": [
            "PROCESS",
            "FLOW",
            "BIG_NUMBER",
            "TIME_COMPRESSION",
            "STATISTICS",
            "COMPARISON",
            "TIMELINE",
            "CHECKLIST",
            "WARNING",
            "SUMMARY",
            "METAPHOR",
            "MAP",
            "CUSTOM_DIAGRAM"
          ]
        },
        "renderMode": { "enum": ["STANDARD", "CREATIVE", "CUSTOM"] },
        "composition": { "type": "object" },
        "content": { "type": "object" },
        "motionSequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "step": { "type": "integer", "minimum": 1 },
              "stepId": { "type": "string" },
              "order": { "type": "integer", "minimum": 1 },
              "atMs": { "type": "number", "minimum": 0 },
              "label": { "type": "string" },
              "action": { "type": "string" },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": { "type": "string" },
                    "targetId": { "type": "string" },
                    "motion": { "type": "string" },
                    "durationMs": { "type": "number", "minimum": 0 },
                    "delayMs": { "type": "number", "minimum": 0 },
                    "value": { "type": ["string", "number"] }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "interaction": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["CLICK", "TIMED"] },
            "dragTargets": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "sound": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["preset"],
                "properties": {
                  "preset": { "type": "string" },
                  "step": { "type": "integer", "minimum": 1 },
                  "volume": { "type": "number", "minimum": 0, "maximum": 1 },
                  "delayMs": { "type": "number", "minimum": 0 }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "assets": { "type": "array", "items": { "type": "object" } },
        "fallback": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
