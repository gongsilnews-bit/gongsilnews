{
  "name": "gongsil-studio",
  "productName": "공실마케팅",
  "version": "0.1.14",
  "description": "공실마케팅 - 공실등록·기사등록·SNS뉴스발행·동영상제작·고객관리",
  "author": "공실뉴스",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:local": "set STUDIO_BASE_URL=http://localhost:3000&& electron .",
    "ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "whisper": "node scripts/fetch-whisper.mjs",
    "dist": "node scripts/sync-ext.mjs && node scripts/fetch-ffmpeg.mjs && node scripts/fetch-whisper.mjs && electron-builder --win nsis"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "lottie-web": "^5.13.0",
    "playwright-core": "1.63",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.gongsilnews.studio",
    "productName": "공실마케팅",
    "executableName": "GongsilStudio",
    "artifactName": "GongsilStudio-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/ext/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "vendor/whisper",
        "to": "whisper"
      },
      {
        "from": "hwp-tool",
        "to": "hwp-tool",
        "filter": [
          "gongsil-hwp.jar",
          "NOTICE.txt"
        ]
      },
      {
        "from": "build/psd.ico",
        "to": "psd.ico"
      }
    ],
    "protocols": [
      {
        "name": "공실마케팅",
        "schemes": [
          "gongsilstudio"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "fileAssociations": [
      {
        "ext": "gss",
        "name": "공실마케팅 영상 파일",
        "description": "공실마케팅 동영상제작 프로젝트",
        "role": "Editor",
        "icon": "gss.ico"
      },
      {
        "ext": "gsn",
        "name": "공실마케팅 뉴스 파일",
        "description": "공실마케팅 뉴스·SNS발행 작업",
        "role": "Editor",
        "icon": "gsn.ico"
      },
      {
        "ext": "gsm",
        "name": "공실마케팅 마케팅 파일",
        "description": "공실마케팅 보고서·홍보지 작업 (예측 보고서 · 매물보고서)",
        "role": "Editor",
        "icon": "gsm.ico"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "공실마케팅",
      "language": "1042",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://aijfktzqtnwhfotfwcka.supabase.co/storage/v1/object/public/studio-app/win"
      }
    ]
  }
}
